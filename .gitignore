# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Game data must never enter the repository: save files, ROMs, and memory card
# dumps are local-only inputs. Synthetic fixtures are allowed under
# test/fixtures/ for the save-engine tests.
*.sav
*.sra
*.srm
*.st0
*.eep
*.fla
*.mpk
*.z64
*.n64
*.v64
*.rom
!/test/fixtures/**

# Local sample fixtures copied out of Longshot at runtime. These are game
# data: they stay in this directory and are never committed.
.local-fixtures/
*.sav
*.eep
# Narrow escape hatch for tiny synthetic JSON fixtures added later.
!/test/fixtures/**
